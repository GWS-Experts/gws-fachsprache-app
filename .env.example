# Kopiere diese Datei nach .env.local und trage die Werte ein.
# .env.local wird nicht zu GitHub hochgeladen (siehe .gitignore).

# Supabase: Project Settings -> API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://ujolqpknyltgrtkxdohr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim! Nur auf dem Server, nie im Browser. Für Einladungen und Passwort-Links.
SUPABASE_SECRET_KEY=sb_secret_...

# Öffentliche Adresse der App (für Links in E-Mails), ohne Schrägstrich am Ende.
# Lokal http://localhost:3000, auf dem Server https://training.gws-transfer-visa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-Mail-Versand (z. B. Hostinger-Postfach). Ohne diese Werte zeigt die App
# Einladungslinks zum Kopieren an und verschickt keine Benachrichtigungen.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Absenderzeile. Muss dieselbe Adresse wie SMTP_USER verwenden, sonst lehnt
# Hostinger die E-Mail ab. Leer lassen = "GWS Fachsprache" <SMTP_USER>.
SMTP_FROM=
# Empfänger für Hinweise auf neue Kundennachrichten (GWS-Postfach)
STAFF_NOTIFY_EMAIL=

# Lern-Erinnerungen: geheimes Passwort für den täglichen Erinnerungs-Aufruf (crontab),
# z. B. mit `openssl rand -hex 32` erzeugen. Ohne Wert werden keine Erinnerungen verschickt.
CRON_SECRET=

# KI-Korrekturvorschläge für Schreibaufgaben (Claude). Geheim! Nur auf dem Server.
# Schlüssel anlegen: https://platform.claude.com -> Settings -> API Keys.
# Ohne Schlüssel gibt es keine KI-Vorschläge, der Rest der App funktioniert normal.
ANTHROPIC_API_KEY=

# Push-Benachrichtigungen aufs Handy (Lern-Erinnerungen, neue Nachrichten).
# Nicht von Hand ausfüllen: `npm run push:setup` erzeugt die Schlüssel und trägt sie hier ein.
# Ohne Werte gibt es keine Push-Benachrichtigungen, der Rest der App funktioniert normal.
VAPID_PUBLIC_KEY=
# Geheim! Nur auf dem Server. Nicht ändern, sonst müssen alle Geräte Push neu einschalten.
VAPID_PRIVATE_KEY=
# Kontaktadresse für die Push-Dienste von Google/Apple/Mozilla, z. B. mailto:noreply@gws-transfer-visa.com
# (leer = mailto:SMTP_USER)
VAPID_SUBJECT=
