# Kopiere diese Datei nach .env.local und trage die Werte ein.
# .env.local wird nicht zu GitHub hochgeladen (siehe .gitignore).

# Supabase: Project Settings -> API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://ujolqpknyltgrtkxdohr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim! Nur auf dem Server, nie im Browser. Für Einladungen und Passwort-Links.
SUPABASE_SECRET_KEY=sb_secret_...

# Öffentliche Adresse der App (für Links in E-Mails), ohne Schrägstrich am Ende
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-Mail-Versand (z. B. Hostinger-Postfach). Ohne diese Werte zeigt die App
# Einladungslinks zum Kopieren an und verschickt keine Benachrichtigungen.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GWS Fachsprache <noreply@gws-talent-transfer.com>"
# Empfänger für Hinweise auf neue Kundennachrichten (GWS-Postfach)
STAFF_NOTIFY_EMAIL=
